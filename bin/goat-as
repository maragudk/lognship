#!/usr/bin/env bash
# goat-as: switch the active goat session between named profiles.
#
# Usage:
#   goat-as <profile>              swap active session to <profile>
#   goat-as <profile> -- <cmd...>  run a single command under <profile>, then restore
#   goat-as --save <profile>       save the current active session as <profile>
#   goat-as --list                 list known profiles and the active one
#   goat-as --which                print which profile matches the active session (by DID)

set -euo pipefail

PROFILE_DIR="${GOAT_PROFILE_DIR:-$HOME/.config/goat-profiles}"
SESSION_FILE="$HOME/Library/Application Support/goat/auth-session.json"

die() { echo "goat-as: $*" >&2; exit 1; }

active_did() {
  [[ -f "$SESSION_FILE" ]] || return 0
  awk -F'"' '/"did"[[:space:]]*:/ { print $4; exit }' "$SESSION_FILE"
}

profile_did() {
  awk -F'"' '/"did"[[:space:]]*:/ { print $4; exit }' "$1"
}

cmd_list() {
  local active
  active="$(active_did || true)"
  shopt -s nullglob
  for f in "$PROFILE_DIR"/*.json; do
    local name did marker=""
    name="$(basename "$f" .json)"
    did="$(profile_did "$f")"
    [[ "$did" == "$active" ]] && marker=" *"
    printf "%s\t%s%s\n" "$name" "$did" "$marker"
  done
}

cmd_which() {
  local active
  active="$(active_did || true)"
  [[ -n "$active" ]] || die "no active session"
  shopt -s nullglob
  for f in "$PROFILE_DIR"/*.json; do
    if [[ "$(profile_did "$f")" == "$active" ]]; then
      basename "$f" .json
      return 0
    fi
  done
  echo "(unsaved: $active)"
}

cmd_save() {
  local name="$1"
  [[ -n "$name" ]] || die "save: missing profile name"
  [[ -f "$SESSION_FILE" ]] || die "no active session to save (run 'goat account login' first)"
  mkdir -p -m 700 "$PROFILE_DIR"
  install -m 600 "$SESSION_FILE" "$PROFILE_DIR/$name.json"
  echo "saved profile: $name ($(profile_did "$PROFILE_DIR/$name.json"))"
}

swap_to() {
  local name="$1"
  local src="$PROFILE_DIR/$name.json"
  [[ -f "$src" ]] || die "unknown profile: $name (try --list)"
  mkdir -p "$(dirname "$SESSION_FILE")"
  install -m 600 "$src" "$SESSION_FILE"
}

cmd_run() {
  local name="$1"; shift
  local restore=""
  if [[ -f "$SESSION_FILE" ]]; then
    restore="$(mktemp -t goat-as-restore.XXXXXX)"
    cp -p "$SESSION_FILE" "$restore"
  fi
  swap_to "$name"
  local rc=0
  goat "$@" || rc=$?
  if [[ -n "$restore" ]]; then
    install -m 600 "$restore" "$SESSION_FILE"
    rm -f "$restore"
  fi
  return "$rc"
}

[[ $# -ge 1 ]] || die "usage: goat-as <profile> [-- <cmd...>] | --save <profile> | --list | --which"

case "$1" in
  --list) cmd_list ;;
  --which) cmd_which ;;
  --save) shift; cmd_save "${1:-}" ;;
  -h|--help)
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    name="$1"; shift || true
    if [[ $# -eq 0 ]]; then
      swap_to "$name"
      echo "active profile: $name ($(profile_did "$PROFILE_DIR/$name.json"))"
    elif [[ "$1" == "--" ]]; then
      shift
      cmd_run "$name" "$@"
    else
      die "expected '--' before command, got: $1"
    fi
    ;;
esac
